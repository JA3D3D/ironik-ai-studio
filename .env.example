# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Your live site address, e.g. https://ai.ironikgrafix.com (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI → API keys
OPENAI_API_KEY=
# Optional: override the AI models (defaults shown)
# Drafts use the fast, cheap model; Standard and High use Sunburst.
OPENAI_DRAFT_MODEL=gpt-image-2
OPENAI_FINAL_MODEL=gpt-image-2.6-sunburst

# Stripe → Developers → API keys (use the test keys first)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Stripe → Product catalog → "Pro" product → its $29/month price id (price_...)
STRIPE_PRO_PRICE_ID=
